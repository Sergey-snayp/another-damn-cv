PORT=3001
DATABASE_URL=postgresql://cv:cv@localhost:5433/cv_platform?schema=public

# The Claude CLI reads job pages and tailors resumes. Sign it in once with `claude`.
CLAUDE_BIN=claude
LLM_MODEL=claude-sonnet-5
# Optional interview-only model. If omitted, uses LLM_MODEL.
# INTERVIEW_MODEL=your-available-model
# Optional model for the CV summary in Quick tailoring. Defaults to claude-sonnet-5-5.
# SUMMARY_MODEL=claude-sonnet-5-5
# Optional small model that fixes a summary's failed checks. Defaults to claude-haiku-5-5.
# SUMMARY_FIX_MODEL=claude-haiku-5-5

# From console.cloud.google.com — OAuth 2.0 Client ID (Web application).
# Authorised JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=
SESSION_SECRET=generate-with-openssl-rand-hex-32
FRONTEND_URL=http://localhost:5173

# ── Deployed server only (see render.yaml) ──
# Who may sign in, comma separated. Empty lets anyone in.
# ALLOWED_EMAILS=you@example.com
# The built web app to serve from this process (the Docker image sets it).
# STATIC_DIR=/app/frontend/dist
# Where the server's Chrome opens CVs to print them (the Docker image uses localhost).
# PRINT_URL=http://127.0.0.1:3001
# Chrome inside a container runs without its own sandbox.
# CHROME_NO_SANDBOX=1
# The Claude CLI's sign-in on a server: run `claude setup-token` and paste the token.
# CLAUDE_CODE_OAUTH_TOKEN=

PORT=3001
DATABASE_URL=postgresql://cv:cv@localhost:5433/cv_platform?schema=public

# The Claude CLI reads job pages and tailors resumes. Sign it in once with `claude`.
CLAUDE_BIN=claude
LLM_MODEL=claude-sonnet-5
# Optional interview-only model. If omitted, uses LLM_MODEL.
# INTERVIEW_MODEL=your-available-model

# From console.cloud.google.com — OAuth 2.0 Client ID (Web application).
# Authorised JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=
SESSION_SECRET=generate-with-openssl-rand-hex-32
FRONTEND_URL=http://localhost:5173

// Schema is the readable summary of the whole system — keep it that way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Created on first Google sign-in. There is no password: Google is the only
/// identity provider, so there is nothing to hash, reset or leak.
model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @updatedAt

  /// Bearer token for the browser extension.
  ///
  /// The extension runs on a chrome-extension:// origin, so the session cookie
  /// cannot reach it — SameSite blocks it, and relaxing that would weaken CSRF
  /// protection for the web app. A revocable per-user token is the honest
  /// alternative: it carries no ambient authority and can be rotated alone.
  syncToken String? @unique

  factBase     FactBase?
  applications Application[]
  profile      Profile?

  @@map("users")
}

/// One fact base per user, kept as JSON rather than shredded into tables.
///
/// Deliberate: the shape is nested, versioned and read whole every time. Rows
/// would buy referential integrity nobody needs here and cost the ability to
/// diff a career as one document.
model FactBase {
  id        String   @id @default(uuid())
  userId    String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fact_bases")
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  INTERVIEWING
  REJECTED
  OFFER
}

/// The application log.
///
/// `masterCommit` is what lets a resume sent weeks ago be reproduced exactly.
/// `notClaimed` is the interview-prep list for that specific application — the
/// half of the output that matters more than the resume.
model Application {
  id        String            @id @default(uuid())
  userId    String
  company   String
  role      String
  url       String?
  appliedAt DateTime          @default(now())
  status    ApplicationStatus @default(DRAFT)

  masterCommit   String?
  summaryVariant String?
  claimed        String[]
  notClaimed     String[]
  sentFile       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appliedAt])
  @@map("applications")
}

/// Owned by connect-pg-simple, declared here so Prisma's migration history is
/// the single account of the schema. Without it every later migration reports
/// drift and offers to reset the database.
///
/// The shape must match what connect-pg-simple expects exactly; createTableIfMissing
/// is off in main.ts now that Prisma owns it.
model UserSession {
  sid    String   @id @map("sid")
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Versioned resumes
//
// A Snapshot is a commit. Content rows carry the snapshot they appeared in and
// the one that replaced them; supersededInSnapshotId = null means live.
// Unchanged rows are never copied — they simply keep living.
//
// Resume.current is a materialised projection of the live rows. It is DERIVED:
// only materialise() writes it, and rebuild() can always reconstruct it. That
// is what makes it a cache rather than a second source of truth.
// ─────────────────────────────────────────────────────────────────────────────

/// The person. Never versioned — it changes rarely and is what the extension
/// fills into application forms.
model Profile {
  id     String @id @default(uuid())
  userId String @unique

  firstName     String  @default("")
  lastName      String  @default("")
  preferredName String?
  pronouns      String?
  email         String  @default("")
  phone         String?

  location   String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  linkedin  String?
  github    String?
  portfolio String?
  website   String?

  workAuthorization   String?
  requiresSponsorship String?
  salaryExpectation   String?
  noticePeriod        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes Resume[]

  @@map("profiles")
}

/// One resume. A profile keeps several: "Backend Engineer", "Platform".
model Resume {
  id         String  @id @default(uuid())
  profileId  String
  name       String
  targetRole String?
  isPrimary  Boolean @default(false)

  currentSnapshotId String?
  /// Materialised live state. Derived; never authored.
  current        Json?
  materialisedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  snapshots   Snapshot[]
  contacts    ContactInformation[]
  experiences ExperienceEntry[]
  achievements Achievement[]
  educations  EducationEntry[]
  skills      SkillEntry[]
  summaries   SummaryVariant[]

  @@index([profileId])
  @@map("resumes")
}

/// A save. Holds no content — content is whatever was live at this point.
model Snapshot {
  id       String @id @default(uuid())
  resumeId String
  number   Int
  message  String?

  createdAt DateTime @default(now())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, number])
  @@map("snapshots")
}

model ContactInformation {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  firstName String  @default("")
  lastName  String  @default("")
  email     String  @default("")
  phone     String?
  location  String?
  linkedin  String?
  github    String?
  website   String?

  createdInSnapshot Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("contact_information")
}

model ExperienceEntry {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  company  String
  client   String?
  title    String
  location String?
  from     String
  to       String?
  current  Boolean @default(false)
  blurb    String?
  position Int     @default(0)

  createdInSnapshot Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("experience_entries")
}

/// Bullets live apart from the role: they are reworded far more often than a
/// job title changes, and keeping them inside would copy company and dates
/// every time one word moved.
model Achievement {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  /// Points at the role's LINEAGE, not a version — otherwise editing a job
  /// title orphans every bullet under it.
  experienceLineageId String

  problem String?
  action  String?
  result  String?
  bullet  String

  /// True only with an evidence string naming a repo, commit, file or migration.
  verified Boolean @default(false)
  evidence String?
  /// 1-5, how much the owner wants this surfaced.
  weight   Int     @default(3)
  /// Human wording is never overwritten by the generator.
  authoredBy String @default("generator")
  position   Int    @default(0)

  createdInSnapshot Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([experienceLineageId])
  @@index([lineageId])
  @@map("achievements")
}

model EducationEntry {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  institution String
  fullName    String?
  degree      String
  field       String?
  from        String
  to          String?
  position    Int     @default(0)

  createdInSnapshot Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("education_entries")
}

model SkillEntry {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  name     String
  category String   @default("")
  level    String?
  years    Int?
  verified Boolean  @default(false)
  evidence String?
  weight   Int      @default(3)
  aliases  String[]

  createdInSnapshot Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("skill_entries")
}

/// "default", "payments", "highload" — one career, angled differently.
model SummaryVariant {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  variant String
  text    String

  createdInSnapshot Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("summary_variants")
}

// Schema is the readable summary of the whole system — keep it that way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Created on first Google sign-in. There is no password: Google is the only
/// identity provider, so there is nothing to hash, reset or leak.
model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @updatedAt

  /// Bearer token for the browser extension.
  ///
  /// The extension runs on a chrome-extension:// origin, so the session cookie
  /// cannot reach it — SameSite blocks it, and relaxing that would weaken CSRF
  /// protection for the web app. A revocable per-user token is the honest
  /// alternative: it carries no ambient authority and can be rotated alone.
  syncToken String? @unique

  factBase     FactBase?
  applications Application[]

  @@map("users")
}

/// One fact base per user, kept as JSON rather than shredded into tables.
///
/// Deliberate: the shape is nested, versioned and read whole every time. Rows
/// would buy referential integrity nobody needs here and cost the ability to
/// diff a career as one document.
model FactBase {
  id        String   @id @default(uuid())
  userId    String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fact_bases")
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  INTERVIEWING
  REJECTED
  OFFER
}

/// The application log.
///
/// `masterCommit` is what lets a resume sent weeks ago be reproduced exactly.
/// `notClaimed` is the interview-prep list for that specific application — the
/// half of the output that matters more than the resume.
model Application {
  id        String            @id @default(uuid())
  userId    String
  company   String
  role      String
  url       String?
  appliedAt DateTime          @default(now())
  status    ApplicationStatus @default(DRAFT)

  masterCommit   String?
  summaryVariant String?
  claimed        String[]
  notClaimed     String[]
  sentFile       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appliedAt])
  @@map("applications")
}

/// Owned by connect-pg-simple, declared here so Prisma's migration history is
/// the single account of the schema. Without it every later migration reports
/// drift and offers to reset the database.
///
/// The shape must match what connect-pg-simple expects exactly; createTableIfMissing
/// is off in main.ts now that Prisma owns it.
model UserSession {
  sid    String   @id @map("sid")
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}

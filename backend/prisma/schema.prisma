// Schema is the readable summary of the whole system — keep it that way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Created on first Google sign-in. There is no password: Google is the only
/// identity provider, so there is nothing to hash, reset or leak.
model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @updatedAt

  /// Bearer token for the browser extension.
  ///
  /// The extension runs on a chrome-extension:// origin, so the session cookie
  /// cannot reach it — SameSite blocks it, and relaxing that would weaken CSRF
  /// protection for the web app. A revocable per-user token is the honest
  /// alternative: it carries no ambient authority and can be rotated alone.
  syncToken String? @unique

  jobs                  Job[]
  profile               Profile?
  interviewPreparations InterviewPreparation[]
  interviewPractice     InterviewPractice[]
  savedAnswers          SavedAnswer[]
  autofillDefaults      AutofillDefault[]

  @@map("users")
}

enum JobSource {
  EXTENSION
  SCANNER
  MANUAL
}

/// Where a job stands. Saved → Applied → Screening → Interview → Offer are
/// the board's columns; Accepted, Rejected and Declined close it; Dismissed is
/// "not for me" and stays off the board.
enum JobStatus {
  SAVED
  DISMISSED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  DECLINED
}

/// How the fields were read. PENDING while a model is reading the page in the
/// background; STRUCTURED when the page's own JSON-LD gave them.
enum JobExtraction {
  PENDING
  STRUCTURED
  LLM
  MANUAL
  FAILED
}

/// Every posting you might apply to: sent from the extension, found by the
/// scanner, or pasted by hand.
///
/// `canonicalUrl` is what makes sending the same job twice an update. It is
/// null for pasted jobs without a link, and Postgres lets nulls repeat under a
/// unique index, so those never collide.
///
/// `html`, `pageText` and `structuredData` are kept as captured, so a better
/// reader can re-run later and a posting outlives its page.
model Job {
  id     String    @id @default(uuid())
  userId String
  source JobSource

  url          String?
  canonicalUrl String?

  title          String?
  company        String?
  /// The company's logo as an image address, found on the page by the extension.
  companyLogo    String?
  location       String?
  remote         Boolean?
  employmentType String?
  salary         String?
  postedAt       DateTime?
  description    String?

  /// Fields the person has edited. A re-capture refreshes everything else.
  editedFields String[]

  pageTitle      String?
  html           String?
  pageText       String?
  structuredData Json?

  extraction      JobExtraction
  extractionError String?

  status     JobStatus @default(SAVED)
  capturedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  isFavorite          Boolean   @default(false)
  archivedAt          DateTime?
  appliedAt           DateTime?
  applicationResumeId String?
  applicationSnapshot Int?
  /// The company's questions and the person's answers when they applied, from
  /// the extension: [{ question, answer }].
  applicationAnswers  Json?
  /// Calendar date and optional wall time in the selected IANA time zone.
  interviewDate       String?
  interviewTime       String?
  interviewTimeZone   String?

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes           Resume[]
  statusEvents      JobStatusEvent[]
  applicationResume Resume?               @relation("ApplicationResume", fields: [applicationResumeId], references: [id], onDelete: SetNull)
  preparation       InterviewPreparation?
  practice          InterviewPractice[]

  @@unique([userId, canonicalUrl])
  @@index([userId, status, createdAt])
  @@index([extraction])
  @@index([userId, archivedAt])
  @@map("jobs")
}

/// The user's notes for the next interview. Generated content never writes here.
model InterviewPreparation {
  id            String   @id @default(uuid())
  userId        String
  jobId         String   @unique
  interviewType String?
  interviewer   String   @default("")
  instructions  String   @default("")
  notes         String   @default("")
  questions     String   @default("")
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("interview_preparations")
}

/// Latest generated question set per job and kind, separate from the user's notes.
model InterviewPractice {
  id            String   @id @default(uuid())
  userId        String
  jobId         String
  kind          String
  inputHash     String
  promptVersion String
  provider      String
  model         String
  output        Json
  generatedAt   DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, kind])
  @@index([userId])
  @@map("interview_practice")
}

/// Your answer to an application question a form asked, kept so the extension
/// can fill it next time. Saved only when you choose "Save answers".
///
/// `questionKey` is the question lowercased without punctuation: the same
/// question on another form finds this row. `company` is where the answer was
/// written, so an answer naming that company is not reused for another one.
model SavedAnswer {
  id          String    @id @default(uuid())
  userId      String
  question    String
  questionKey String
  answer      String
  company     String?
  usedCount   Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId])
  @@map("saved_answers")
}

/// An answer the extension uses for one kind of question, chosen from a field's
/// icon on a form. `scope` narrows it: the country for work authorization and
/// sponsorship ("Poland"), or "" for the general answer ("worked here before"
/// is always one answer for every company). `scopeKey` is the scope lowercased, so "poland" and
/// "Poland" are one row.
model AutofillDefault {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  scope     String
  scopeKey  String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, scopeKey])
  @@index([userId])
  @@map("autofill_defaults")
}

/// One status change, so a move can be undone and the job page can show its
/// timeline. The job's status and its event are written in one transaction.
model JobStatusEvent {
  id    String    @id @default(uuid())
  jobId String
  from  JobStatus
  to    JobStatus
  at    DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, at])
  @@map("job_status_events")
}

/// Owned by connect-pg-simple, declared here so Prisma's migration history is
/// the single account of the schema. Without it every later migration reports
/// drift and offers to reset the database.
///
/// The shape must match what connect-pg-simple expects exactly; createTableIfMissing
/// is off in main.ts now that Prisma owns it.
model UserSession {
  sid    String   @id @map("sid")
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Versioned resumes
//
// A Snapshot is a commit. Content rows carry the snapshot they appeared in and
// the one that replaced them; supersededInSnapshotId = null means live.
// Unchanged rows are never copied — they simply keep living.
//
// Resume.current is a materialised projection of the live rows. It is DERIVED:
// only materialise() writes it, and rebuild() can always reconstruct it. That
// is what makes it a cache rather than a second source of truth.
// ─────────────────────────────────────────────────────────────────────────────

/// The person. Never versioned — it changes rarely and is what the extension
/// fills into application forms.
model Profile {
  id     String @id @default(uuid())
  userId String @unique

  firstName     String  @default("")
  lastName      String  @default("")
  preferredName String?
  pronouns      String?
  email         String  @default("")
  phone         String?

  location   String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  linkedin  String?
  github    String?
  portfolio String?
  website   String?
  telegram  String?

  workAuthorization   String?
  requiresSponsorship String?
  salaryExpectation   String?
  noticePeriod        String?
  /// Types of work accepted, in order: "remote,hybrid,onsite" or any of them.
  workArrangements    String?

  /// Reviewed career sections imported into Profile, independent of CV versions.
  career         Json?
  careerRevision Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes Resume[]

  @@map("profiles")
}

/// One resume. A profile keeps several: "Backend Engineer", "Platform".
model Resume {
  id         String  @id @default(uuid())
  profileId  String
  name       String
  targetRole String?
  isPrimary  Boolean @default(false)

  /// Set on a copy tailored for one job. The job may be deleted; the copy stays.
  jobId          String?
  /// The resume this copy was made from.
  sourceResumeId String?
  /// Suggestions from the last "Tailor resume", waiting for review. Nothing in
  /// here is on the resume until the person accepts it.
  tailoring      Json?

  currentSnapshotId String?
  /// Materialised live state. Derived; never authored.
  current           Json?
  materialisedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job             Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  snapshots       Snapshot[]
  contacts        ContactInformation[]
  experiences     ExperienceEntry[]
  achievements    Achievement[]
  educations      EducationEntry[]
  skills          SkillEntry[]
  summaries       SummaryVariant[]
  applicationJobs Job[]                @relation("ApplicationResume")

  @@index([profileId])
  @@index([jobId])
  @@map("resumes")
}

/// A save. Holds no content — content is whatever was live at this point.
model Snapshot {
  id       String  @id @default(uuid())
  resumeId String
  number   Int
  message  String?

  createdAt DateTime @default(now())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, number])
  @@map("snapshots")
}

model ContactInformation {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  firstName String  @default("")
  lastName  String  @default("")
  email     String  @default("")
  phone     String?
  location  String?
  linkedin  String?
  github    String?
  website   String?

  createdInSnapshot    Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("contact_information")
}

model ExperienceEntry {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  company  String
  client   String?
  title    String
  location String?
  from     String
  to       String?
  current  Boolean @default(false)
  blurb    String?
  position Int     @default(0)

  createdInSnapshot    Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("experience_entries")
}

/// Bullets live apart from the role: they are reworded far more often than a
/// job title changes, and keeping them inside would copy company and dates
/// every time one word moved.
model Achievement {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  /// Points at the role's LINEAGE, not a version — otherwise editing a job
  /// title orphans every bullet under it.
  experienceLineageId String

  problem String?
  action  String?
  result  String?
  bullet  String

  /// True only with an evidence string naming a repo, commit, file or migration.
  verified   Boolean @default(false)
  evidence   String?
  /// 1-5, how much the owner wants this surfaced.
  weight     Int     @default(3)
  /// Human wording is never overwritten by the generator.
  authoredBy String  @default("generator")
  position   Int     @default(0)

  createdInSnapshot    Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([experienceLineageId])
  @@index([lineageId])
  @@map("achievements")
}

model EducationEntry {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  institution String
  fullName    String?
  degree      String
  field       String?
  from        String
  to          String?
  position    Int     @default(0)

  createdInSnapshot    Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("education_entries")
}

model SkillEntry {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  name     String
  category String   @default("")
  level    String?
  years    Int?
  verified Boolean  @default(false)
  evidence String?
  weight   Int      @default(3)
  aliases  String[]
  /// Most relevant first; tailoring reorders these.
  position Int      @default(0)

  createdInSnapshot    Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("skill_entries")
}

/// "default", "payments", "highload" — one career, angled differently.
model SummaryVariant {
  id        String @id @default(uuid())
  lineageId String
  resumeId  String

  variant String
  text    String

  createdInSnapshot    Int
  supersededInSnapshot Int?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, supersededInSnapshot])
  @@index([lineageId])
  @@map("summary_variants")
}

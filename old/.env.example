# --- Telegram ---------------------------------------------------------------
# 1. Message @BotFather → /newbot → copy the token here.
# 2. Run `npm run bot`, send /start to your bot, it replies with your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM --------------------------------------------------------------------
# claude-cli = your Claude Code subscription (host only, free, interactive use)
# api        = metered API key (required in Docker and for unattended cron)
LLM_PROVIDER=claude-cli
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# Only if `claude` isn't on PATH (e.g. an IDE-only install). Absolute path.
CLAUDE_BIN=

# --- Paths / locale ---------------------------------------------------------
# Only if `tectonic` isn't on PATH. Absolute path.
TECTONIC_BIN=
TZ=America/Vancouver

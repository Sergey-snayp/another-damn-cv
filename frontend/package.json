{
  "name": "cv-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../extension/scripts/sync-theme.cjs",
    "dev": "vite",
    "prebuild": "node ../extension/scripts/sync-theme.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:browser": "node test/quick-tailor-save.cjs && node test/profile-career.cjs && node test/profile-employment.cjs",
    "test:browser:documents": "node test/document-library.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}

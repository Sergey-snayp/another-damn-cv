{
  "manifest_version": 3,
  "name": "CV Autofill",
  "version": "0.19.0",
  "description": "Fills job application forms from your profile, and sends job postings to your app.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/brand/d-stamp-logo.png",
    "32": "assets/brand/d-stamp-logo.png",
    "48": "assets/brand/d-stamp-logo.png",
    "128": "assets/brand/d-stamp-logo.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs",
    "identity",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "CV Autofill",
    "default_icon": "assets/brand/d-stamp-logo.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "exclude_matches": [
        "http://localhost:5173/*",
        "http://localhost:3001/*"
      ],
      "js": [
        "src/sites.js",
        "src/fields.js",
        "src/filler.js",
        "src/launcher.js",
        "src/panel-host.js",
        "src/job-form.js",
        "src/content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidepanel.html",
        "assets/brand/d-stamp-logo.png",
        "assets/theme/launcher-colors.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

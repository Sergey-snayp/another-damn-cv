{
  "manifest_version": 3,
  "name": "CV Autofill",
  "version": "0.11.0",
  "description": "Fills job application forms from your profile, and sends job postings to your app.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/brand/d-stamp-logo.png",
    "32": "assets/brand/d-stamp-logo.png",
    "48": "assets/brand/d-stamp-logo.png",
    "128": "assets/brand/d-stamp-logo.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.bamboohr.com/*",
    "https://*.recruitee.com/*",
    "https://*.breezy.hr/*",
    "https://*.applytojob.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "http://localhost:3001/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "CV Autofill",
    "default_icon": "assets/brand/d-stamp-logo.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.recruitee.com/*",
        "https://*.breezy.hr/*",
        "https://*.applytojob.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "file:///*"
      ],
      "js": [
        "src/sites.js",
        "src/fields.js",
        "src/filler.js",
        "src/launcher.js",
        "src/panel-host.js",
        "src/content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidepanel.html",
        "assets/brand/d-stamp-logo.png",
        "assets/theme/launcher-colors.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
